# Local demo only. Mock header authentication is refused when NODE_ENV=production.
AUTH_MODE=mock
DB_TYPE=sqlite

# For OIDC, set AUTH_MODE=oidc and configure values from the company identity provider.
# The API validates access-token signature (RS256), issuer, audience, and expiry.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://identity.example.com/tenant/v2.0
# OIDC_AUDIENCE=api://service-hub
# OIDC_JWKS_URI=https://identity.example.com/tenant/discovery/v2.0/keys
# OIDC_SIGNING_ALGORITHM=RS256
# OIDC_SUBJECT_CLAIM=sub
# OIDC_ROLE_CLAIM=roles
# OIDC_ROLE_MAP={"ServiceHub.Employee":"employee","ServiceHub.Staff":"staff","ServiceHub.Admin":"admin"}
# OIDC_DEPARTMENT_CLAIM=departmentId