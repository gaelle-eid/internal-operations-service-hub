{
  "name": "internal-operations-service-hub-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest --runInBand",
    "test:eval": "jest --runInBand intake.eval.spec.ts",
